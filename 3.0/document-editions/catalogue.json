  "incident_sections": [
    [
      "Respond to the incident",
      "Address immediate risks to the people involved. Let the team leader or manager know what happened and what support is needed."
    ],
    [
      "Make an internal report",
      "The staff member who witnessed the incident completes the report. If nobody witnessed it, the staff member who received the account completes it. Describe what happened in sequence. Distinguish what you observed from what someone told you. Record the action already taken."
    ],
    [
      "Manager follow-up",
      "Check the report for accuracy and arrange support for the people involved. Assess the incident, coordinate any investigation, record the findings and assign follow-up actions."
    ],
    [
      "Use the findings",
      "Review how the incident was managed and what contributed to it. Monitor recurring incidents and use the findings to reduce the risk of future harm."
    ]
  ],
